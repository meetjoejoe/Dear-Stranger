# GEMINI_API_KEY: Required only if Gemini AI API calls are enabled on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (injected in Cloud Run / AI Studio).
APP_URL="https://your-app-url.run.app"

# ---------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required for persistent PostgreSQL & Auth)
# ---------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable (anon) API key — safe to expose to the browser via /api/config
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Secret (service_role) API key — SERVER ONLY! Never expose to browser or VITE_ vars
SUPABASE_SECRET_KEY="sb_secret_your_key_here"

# Optional: Comma-separated list of user UUIDs or verified emails allowed to
# bootstrap as initial administrators (in addition to the admin_users table).
ADMIN_BOOTSTRAP_EMAILS=""
ADMIN_BOOTSTRAP_USER_IDS=""

# ---------------------------------------------------------------------------
# OPTIONAL EMAIL NOTIFICATIONS (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Dear Stranger <notifications@yourdomain.com>"

# ---------------------------------------------------------------------------
# OPTIONAL CAPTCHA PROTECTION (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# SECURITY / RATE LIMITING SALT
# ---------------------------------------------------------------------------
RATE_LIMIT_SALT="change-this-to-a-random-string-in-production"
